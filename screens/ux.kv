#:import rgba kivy.utils.get_color_from_hex
#:import md_icons kivymd.icon_definitions.md_icons
#:import fonts_path kivymd.fonts_path

<UxCaption@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(14)
    color: rgba('#526A74')
    size_hint_y: None
    height: max(dp(30), self.texture_size[1] + dp(12))

<UxSection@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    bold: True
    color: rgba('#526A74')
    size_hint_y: None
    height: dp(28)

<UxToolbar@ViewRow>:
    height: dp(48)
    ViewText:
        text: root.context['title']
        shorten: True
        font_size: sp(23)
        bold: True
    ViewAction:
        icon: root.context['left_icon']
        callback: root.context['left']
        bg: '#FFFFFF'
        fg: '#286F83'
        size_hint_x: None
        width: dp(46)
    ViewAction:
        icon: root.context['right_icon']
        callback: root.context['right']
        bg: '#FFFFFF'
        fg: '#286F83'
        size_hint_x: None
        width: dp(46)

<UxRow@UxPress>:
    callback: root.context['callback']
    orientation: 'horizontal'
    adaptive: False
    size_hint_y: None
    height: max(dp(72), self.ids.row_copy.minimum_height + dp(24))
    padding: dp(12)
    spacing: dp(12)
    bg: '#E1ECEE' if self.state == 'down' else '#F1F6F6'
    radius: 16
    ViewText:
        text: md_icons.get(root.context['icon'], '')
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(24)
        color: rgba('#286F83')
        size_hint_x: None
        width: dp(30)
        halign: 'center'
    ViewColumn:
        id: row_copy
        spacing: dp(3)
        adaptive: True
        pos_hint: {'center_y': .5}
        ViewText:
            text: root.context['title']
            font_size: sp(15)
            bold: True
            wrap: True
            size_hint_y: None
            height: self.texture_size[1]
        ViewText:
            text: root.context['detail']
            font_size: sp(12)
            color: rgba('#526A74')
            shorten: True
            size_hint_y: None
            height: dp(18) if self.text else 0
    ViewText:
        text: md_icons['chevron-right']
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(20)
        color: rgba('#526A74')
        size_hint_x: None
        width: dp(20)

<UxProfile@ViewCard>:
    orientation: 'horizontal'
    adaptive: False
    size_hint_y: None
    height: dp(112)
    padding: dp(16)
    bg: '#E7F3F4'
    ViewColumn:
        spacing: dp(3)
        ViewText:
            text: root.context['name']
            bold: True
            font_size: sp(20)
            shorten: True
        ViewText:
            text: root.context['email']
            font_size: sp(14)
            color: rgba('#526A74')
            shorten: True
    ViewAction:
        icon: 'pencil-outline'
        bg: '#FFFFFF'
        fg: '#286F83'
        size_hint_x: None
        width: dp(46)
        height: dp(46)
        pos_hint: {'center_y': .5}
        callback: root.context['callback']

<UxNotice@UxPress>:
    callback: root.context['callback']
    orientation: 'horizontal'
    adaptive: False
    size_hint_y: None
    height: dp(102)
    padding: dp(14)
    spacing: dp(10)
    radius: 16
    bg: '#E7F3F4' if root.context['unread'] else '#F6F8F8'
    ViewText:
        text: md_icons.get(root.context['icon'], '')
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(24)
        size_hint_x: None
        width: dp(28)
        color: rgba('#286F83')
    ViewColumn:
        spacing: dp(3)
        ViewRow:
            height: dp(25)
            ViewText:
                text: root.context['title']
                bold: root.context['unread']
                font_size: sp(16)
                shorten: True
            ViewText:
                text: root.context['date']
                font_size: sp(10)
                color: rgba('#526A74')
                size_hint_x: None
                width: dp(85)
                halign: 'right'
        ViewText:
            text: root.context['detail']
            font_size: sp(14)
            color: rgba('#526A74')
            wrap: True
            shorten: True
            markup: False

<UxLoading@ViewRow>:
    height: dp(42)
    Widget:
    MDSpinner:
        size_hint: None, None
        size: dp(28), dp(28)
        active: True
        color: rgba('#286F83')
    Widget:

<UxComposer@ViewCard>:
    adaptive: False
    size_hint_y: None
    height: dp(122)
    orientation: 'horizontal'
    padding: dp(10)
    spacing: dp(8)
    bg: '#F1F6F6'
    ViewTextInput:
        id: message
        text: root.context['value']
        hint_text: 'Escribe un mensaje…'
        multiline: True
        font_size: sp(15)
        background_normal: ''
        background_active: ''
        background_color: rgba('#F1F6F6')
        foreground_color: rgba('#193C47')
        padding: dp(10), dp(10)
    ViewAction:
        icon: 'send'
        callback: root.context['callback']
        size_hint_x: None
        width: dp(48)
        height: dp(48)
        pos_hint: {'center_y': .5}

<UxQr@ViewCard>:
    padding: dp(12)
    bg: '#FFFFFF'
    ViewImage:
        source: root.context['source']
        size_hint_y: None
        height: self.width
        fit_mode: 'contain'
        on_texture: self.texture and setattr(self.texture, 'mag_filter', 'nearest')

<UxCode@ViewTextInput>:
    text: root.context['value']
    readonly: True
    multiline: False
    size_hint_y: None
    height: dp(52)
    font_size: sp(14)
    background_normal: ''
    background_active: ''
    background_color: rgba('#F1F6F6')
    foreground_color: rgba('#193C47')
    padding: dp(10), dp(12)
