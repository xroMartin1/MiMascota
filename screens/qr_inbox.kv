#:import design screens.theme
#:import rgba kivy.utils.get_color_from_hex

<QrInboxLabel@ViewText>:
    wrap: True
    markup: False
    size_hint_y: None
    height: max(dp(24), self.texture_size[1] + dp(8))

<QrInboxText@QrInboxLabel>:
    text: root.context.get('text', '')

<QrInboxEntry@ViewAction>:
    text: root.context['text']
    callback: root.context['callback']
    bg: design.BLUE
    fg: design.TEXT
    height: dp(52)

<QrInboxConversation@ViewCard>:
    bg: design.LIME if root.context['sender'] == 'visitor' else design.BLUE
    padding: dp(12)
    radius: 16
    QrInboxLabel:
        text: root.context['label']
        font_size: sp(11)
        bold: True
        color: rgba(design.TEAL)
    QrInboxLabel:
        text: root.context['text']
    QrInboxLabel:
        text: root.context['date']
        font_size: sp(10)
        color: rgba(design.MUTED)
