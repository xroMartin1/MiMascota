#:import design screens.theme
#:import rgba kivy.utils.get_color_from_hex
#:import md_icons kivymd.icon_definitions.md_icons
#:import fonts_path kivymd.fonts_path
#:import sin math.sin

<PremiumTeaser@UxPress>:
    compress_on_press: True
    callback: root.context['callback']
    bg: design.INK
    shadow: False
    radius: design.CARD_RADIUS
    padding: dp(18)
    spacing: dp(8)
    ViewRow:
        height: max(dp(118), root.ids.teaser_copy.minimum_height)
        spacing: dp(8)
        ViewColumn:
            id: teaser_copy
            adaptive: True
            spacing: dp(5)
            ViewText:
                text: 'MI MASCOTA'
                color: rgba('#C5DAD9')
                font_size: sp(11)
                size_hint_y: None
                height: dp(18)
            ViewText:
                text: 'Premium'
                color: rgba(design.LIME)
                bold: True
                font_size: sp(design.TITLE)
                size_hint_y: None
                height: dp(40)
            ViewText:
                text: 'Su Premium está activo.' if root.context.get('active', False) else 'Mantén activa su ficha con el mismo QR.'
                color: rgba(design.WHITE)
                wrap: True
                size_hint_y: None
                height: self.texture_size[1]
        PersonalTag:
            source: root.context.get('source', 'assets/chapa-personalizable.png')
            name: root.context.get('name', 'Tu mascota')
            size_hint_x: None
            width: dp(100)
    ViewText:
        text: '$3.990 CLP / mes'
        color: rgba('#D7E8E2')
        font_size: sp(13)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(6)
    ViewAction:
        text: 'Mi Premium' if root.context.get('active', False) else 'Ver Premium'
        icon: 'arrow-right'
        bg: design.LIME
        fg: design.INK
        callback: root.context['callback']

<PremiumHero@ViewCard>:
    bg: design.INK
    shadow: False
    padding: dp(16)
    spacing: dp(3)
    ViewText:
        text: 'PREMIUM'
        color: rgba(design.LIME)
        bold: True
        halign: 'center'
        font_size: sp(12)
        size_hint_y: None
        height: dp(22)
    PersonalTag:
        source: root.context.get('source', 'assets/chapa-personalizable.png')
        name: root.context.get('name', 'Tu mascota')
        size_hint_y: None
        height: dp(180)
    ViewText:
        text: 'Su chapa QR'
        color: rgba(design.WHITE)
        font_size: sp(25)
        bold: True
        halign: 'center'
        size_hint_y: None
        height: dp(36)
    ViewText:
        text: 'Así se verá su chapa'
        color: rgba('#D7E8E2')
        halign: 'center'
        font_size: sp(12)
        size_hint_y: None
        height: dp(22)

<PremiumWelcome>:
    adaptive: True
    spacing: dp(9)
    padding: [dp(4), dp(8)]
    FloatLayout:
        size_hint_y: None
        height: dp(154)
        ViewPetAvatar:
            kind: root.context.get('kind', 'Perro')
            breed: root.context.get('breed', '')
            size_hint: None, None
            size: dp(132), dp(132)
            pos_hint: {'center_x': .5, 'center_y': .5 + .045 * sin(root.phase * 12.566) * (1 - root.phase)}
        ViewText:
            text: md_icons['heart']
            font_name: fonts_path + 'materialdesignicons-webfont.ttf'
            font_size: sp(20)
            color: rgba(design.TEAL)
            size_hint: None, None
            size: dp(28), dp(28)
            pos_hint: {'center_x': .24, 'center_y': .64 + root.phase * .14}
            opacity: max(0, sin(root.phase * 3.141593)) * .8
        ViewText:
            text: md_icons['heart']
            font_name: fonts_path + 'materialdesignicons-webfont.ttf'
            font_size: sp(16)
            color: rgba('#A294C0')
            size_hint: None, None
            size: dp(24), dp(24)
            pos_hint: {'center_x': .77, 'center_y': .5 + root.phase * .18}
            opacity: max(0, sin(root.phase * 3.141593)) * .8
    ViewText:
        text: '¡Premium renovado!' if root.context.get('renewal', False) else '¡Ya es Premium!'
        bold: True
        color: rgba(design.INK)
        font_size: sp(26)
        halign: 'center'
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(6)
    ViewText:
        text: root.context.get('name', 'Tu mascota')
        bold: True
        font_size: sp(19)
        halign: 'center'
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
    ViewText:
        text: 'Tu pago se completó correctamente.'
        halign: 'center'
        color: rgba(design.MUTED)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
    ViewText:
        text: 'Activo hasta ' + root.context.get('date', '')
        halign: 'center'
        color: rgba(design.TEAL)
        font_size: sp(13)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(6)
    ViewText:
        text: 'La primera compra incluye la chapa física. Las renovaciones mantienen el servicio.'
        halign: 'center'
        color: rgba(design.MUTED)
        font_size: sp(13)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(6)

<PremiumPrice@ViewColumn>:
    adaptive: True
    padding: [dp(4), dp(8)]
    spacing: dp(2)
    ViewText:
        text: '$3.990 CLP'
        font_size: sp(29)
        bold: True
        size_hint_y: None
        height: dp(42)
    ViewText:
        text: 'por mes'
        color: rgba(design.MUTED)
        size_hint_y: None
        height: dp(24)
    ViewText:
        text: 'Renovación manual'
        wrap: True
        font_size: sp(12)
        color: rgba(design.MUTED)
        size_hint_y: None
        height: self.texture_size[1] + dp(6)

<PremiumBenefit@ViewRow>:
    height: max(dp(36), root.ids.benefit_text.texture_size[1] + dp(8))
    ViewText:
        text: md_icons[root.context['icon']]
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        color: rgba(design.TEAL)
        font_size: sp(21)
        size_hint_x: None
        width: dp(30)
        halign: 'center'
    ViewText:
        id: benefit_text
        text: root.context['text']
        wrap: True
        font_size: sp(design.BODY)
    ViewCard:
        adaptive: False
        size_hint: None, None
        size: dp(74), dp(24)
        pos_hint: {'center_y': .5}
        padding: 0
        radius: 12
        bg: design.MINT
        shadow: False
        ViewText:
            text: root.context.get('badge', 'Premium')
            color: rgba(design.TEAL)
            bold: True
            halign: 'center'
            font_size: sp(11)

<PremiumStatus@ViewCard>:
    bg: root.context['bg']
    border: True
    shadow: False
    padding: dp(14)
    spacing: dp(6)
    ViewText:
        text: root.context['title']
        wrap: True
        bold: True
        font_size: sp(16)
        size_hint_y: None
        height: self.texture_size[1]
    ViewText:
        text: root.context['detail']
        wrap: True
        color: rgba(design.MUTED)
        font_size: sp(13)
        size_hint_y: None
        height: self.texture_size[1] if self.text else 0
