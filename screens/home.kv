#:import design screens.theme
#:import rgba kivy.utils.get_color_from_hex

<HomeScreen>:
    md_bg_color: rgba(design.WHITE)

<HomeShell@ViewColumn>:
    spacing: dp(0)
    ViewCard:
        id: header
        bg: design.WHITE
        radius: 0
        orientation: 'horizontal'
        adaptive: False
        size_hint_y: None
        height: dp(72)
        padding: [dp(18), dp(10)]
        spacing: dp(10)
        ViewCard:
            id: brand_icon
            bg: design.INK
            radius: 12
            adaptive: False
            size_hint: None, None
            size: dp(40), dp(40)
            padding: dp(3)
            pos_hint: {'center_y': 0.5}
            ViewImage:
                id: brand_logo
                source: root.context['brand_logo']
                fit_mode: 'contain'
        ViewColumn:
            id: branding
            spacing: dp(0)
            size_hint_y: None
            height: dp(30)
            pos_hint: {'center_y': 0.5}
            ViewText:
                id: brand_title
                text: 'Mi Mascota'
                font_size: sp(20)
                color: rgba(design.TEXT)
                bold: True
                size_hint_y: None
                height: dp(28)
            ViewText:
                id: subtitle
                text: 'Inicio'
                font_size: sp(11)
                color: rgba('#71838B')
                size_hint_y: None
                height: 0
                opacity: 0
        ViewRow:
            id: header_actions
            height: dp(48)
            spacing: dp(8)
            size_hint_x: None
            width: dp(104)
            pos_hint: {'center_y': 0.5}
            FloatLayout:
                size_hint_x: None
                width: dp(48)
                height: dp(48)
                ViewAction:
                    id: notifications
                    icon: 'bell-outline'
                    bg: design.BLUE
                    fg: design.TEAL
                    radius: design.CARD_RADIUS
                    callback: root.context['notifications']
                    size_hint: 1, 1
                    pos_hint: {'x': 0, 'y': 0}
                ViewText:
                    id: qr_unread_badge
                    text: ''
                    opacity: 0
                    size_hint: None, None
                    size: dp(19), dp(19)
                    pos_hint: {'right': 1.12, 'top': 1.12}
                    font_size: sp(9)
                    color: rgba(design.WHITE)
                    halign: 'center'
                    bold: True
                    canvas.before:
                        Color:
                            rgba: rgba(design.TEXT)
                        Ellipse:
                            pos: self.pos
                            size: self.size
            PremiumAccountButton:
                id: account
                icon: 'account-outline'
                bg: design.BLUE
                fg: design.TEAL
                size_hint_x: None
                width: dp(48)
                height: dp(48)
                radius: design.CARD_RADIUS
                callback: root.context['account']
    ViewScrollView:
        id: scroll
        do_scroll_x: False
        bar_width: dp(2)
        bar_color: (0, 0.32, 0.27, 0.2)
        ViewColumn:
            id: content
            spacing: dp(16)
            padding: [dp(v) for v in [18, 18, 18, 26]]
            adaptive: True
    ViewCard:
        id: navigation
        bg: design.WHITE
        radius: 0
        orientation: 'horizontal'
        adaptive: False
        size_hint_y: None
        height: dp(68)
        padding: [dp(6), dp(6)]
        spacing: dp(2)

<NavigationQr@ViewAction>:
    padding: [dp(1), dp(5)]
    text: root.context['text']
    icon: root.context['icon']
    vertical: True
    font_size: 11
    bg: design.INK if root.context['selected'] else design.WHITE
    fg: design.WHITE if root.context['selected'] else design.TEAL
    callback: root.context['callback']

<NavigationTab@ViewAction>:
    padding: [dp(1), dp(5)]
    text: root.context['text']
    icon: root.context['icon']
    vertical: True
    font_size: 11
    bg: design.LIME if root.context['selected'] else design.WHITE
    fg: design.INK if root.context['selected'] else design.MUTED
    callback: root.context['callback']

<HeadingBox@ViewColumn>:
    adaptive: True
    spacing: dp(3)

<HeadingLine@ViewRow>:
    height: dp(25)

<HeadingTag@ViewPill>:
    text: root.context['text']
    icon: 'check-decagram'

<HeadingSpacer@ViewText>:
    text: ''
    size_hint_x: 0.22

<HeadingTitle@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(design.TITLE)
    color: rgba(design.TEXT)
    bold: True
    size_hint_y: None
    height: max(dp(31), self.texture_size[1] + dp(4))

<HeadingSubtitle@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(design.BODY)
    color: rgba('#71838B')
    size_hint_y: None
    height: max(dp(22), self.texture_size[1] + dp(4))

<DetailRowLine@ViewRow>:
    height: dp(50)
    spacing: dp(12)
    ViewIconTile:
        icon: root.context['icon']
        bg: '#FBEAE1' if root.context['warm'] else design.BLUE
    ViewColumn:
        spacing: dp(2)
        ViewText:
            text: root.context['title']
            font_size: sp(16)
            color: rgba(design.TEXT)
            bold: True
            size_hint_y: None
            height: dp(26)
            shorten: True
        ViewText:
            text: root.context['detail']
            font_size: sp(11)
            color: rgba('#71838B')
            size_hint_y: None
            height: dp(22)
            shorten: True

<LinkCard@ViewCard>:
    padding: dp(12)
    spacing: dp(0)

<LinkCardLine@ViewRow>:
    height: dp(52)
    spacing: dp(10)

<LinkArrow@ViewAction>:
    icon: 'arrow-right'
    size_hint_x: None
    width: dp(38)
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']
    radius: 19

<CareDialog@ViewModalView>:
    size_hint: (0.92, None)
    height: dp(root.context['height'])
    background_color: (0, 0, 0, 0)
    overlay_color: (0.02, 0.12, 0.1, 0.45)
    ViewCard:
        id: card
        adaptive: False
        padding: dp(22)
        spacing: dp(design.GAP)
        ViewRow:
            height: max(dp(48), root.ids.dialog_title.texture_size[1])
            ViewText:
                id: dialog_title
                text: root.context['text']
                wrap: True
                size_hint_y: None
                height: self.texture_size[1]
                font_size: sp(20)
                color: rgba(design.TEXT)
                bold: True
            ViewAction:
                icon: 'close'
                size_hint_x: None
                width: dp(48)
                height: dp(48)
                bg: design.BLUE
                fg: design.TEAL
                callback: root.context['callback']

<MessageBody@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(design.BODY)
    color: rgba('#71838B')
    size_hint_y: None
    height: self.texture_size[1] + dp(12)

<MessageAccept@ViewAction>:
    text: 'Entendido'
    callback: root.context['callback']

<SavedFeedback@ViewCard>:
    adaptive: False
    size_hint: (None, None)
    width: min(dp(360), root.parent.width - dp(32)) if root.parent else dp(300)
    height: dp(52)
    pos_hint: {'center_x': .5}
    y: dp(88)
    bg: design.TEXT
    radius: 20
    padding: [dp(16), dp(10)]
    ViewText:
        text: root.context['text']
        color: rgba(design.WHITE)
        font_size: sp(design.BODY)
        bold: True
