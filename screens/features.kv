#:import design screens.theme
#:import Window kivy.core.window.Window
#:import rgba kivy.utils.get_color_from_hex
#:import md_icons kivymd.icon_definitions.md_icons
#:import fonts_path kivymd.fonts_path

<HomeFloatingTag@ViewFloatingTag>:
    size_hint_x: None
    width: dp(112)

<HomeVectorTag@ViewTagArt>:
    size_hint_x: None
    width: dp(112)

<RoutineImageBanner@ViewImage>:
    source: root.context['source']
    fit_mode: 'cover'
    size_hint_y: None
    height: min(dp(144), Window.height * .17)

<RoutineVectorBanner@ViewSpaArt>:
    size_hint_y: None
    height: dp(112)

<HomeSection@ViewRow>:
    height: dp(48)
    ViewText:
        text: root.context['title']
        bold: True
        font_size: sp(21)
    ViewAction:
        text: root.context['action']
        callback: root.context['callback']
        bg: design.WHITE
        fg: design.TEAL
        size_hint_x: None
        width: dp(94)
        height: dp(48)

<HomePetRow@UxPress>:
    compress_on_press: True
    border: not root.context.get('selected', False)
    callback: root.context['callback']
    adaptive: False
    orientation: 'horizontal'
    size_hint_y: None
    height: max(dp(160), self.ids.pet_copy.minimum_height + dp(32))
    padding: dp(14)
    spacing: dp(design.GAP)
    radius: design.CARD_RADIUS
    bg: design.LAVENDER if root.context['kind'].strip().casefold() == 'gato' else design.MINT
    ViewColumn:
        size_hint: None, None
        size: dp(104), dp(128)
        pos_hint: {'center_y': .5}
        PetPortrait:
            size: dp(104), dp(128)
            kind: root.context['kind']
            breed: root.context.get('breed', '')
    ViewColumn:
        id: pet_copy
        adaptive: True
        spacing: dp(4)
        pos_hint: {'center_y': .5}
        ViewText:
            text: root.context['name']
            wrap: True
            bold: True
            font_size: sp(23)
            size_hint_y: None
            height: self.texture_size[1]
        ViewText:
            text: root.context['detail']
            wrap: True
            font_size: sp(13)
            color: rgba(design.MUTED)
            size_hint_y: None
            height: self.texture_size[1]

    ViewText:
        text: md_icons['check-circle'] if root.context.get('selected') else md_icons['chevron-right']
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(24)
        color: rgba(design.MUTED)
        halign: 'center'
        size_hint_x: None
        width: self.font_size + dp(8)

<CareTaskTitle@ViewText>:
    text: root.context['text']
    wrap: True
    bold: True
    font_size: sp(17)
    size_hint_y: None
    height: self.texture_size[1] + dp(4)

<HomeNote@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(design.BODY)
    color: rgba(design.MUTED)
    size_hint_y: None
    height: self.texture_size[1] + dp(4)

<HomeEmptyPets@ViewCard>:
    adaptive: True
    bg: design.MINT
    spacing: dp(design.GAP)
    ViewPetAvatar:
        kind: 'Perro'
        size_hint: None, None
        size: dp(96), dp(96)
    ViewText:
        text: 'Añade tu primera mascota'
        bold: True
        wrap: True
        font_size: sp(24)
        size_hint_y: None
        height: self.texture_size[1] + dp(6)
    ViewText:
        text: 'Crea su perfil para registrar sus cuidados, vacunas y citas. Puedes empezar sin una cuenta.'
        wrap: True
        font_size: sp(design.BODY)
        color: rgba(design.MUTED)
        size_hint_y: None
        height: self.texture_size[1] + dp(8)

<HomeRegisterPet@ViewAction>:
    text: 'Añadir mascota'
    icon: 'plus'
    bg: design.INK
    fg: design.WHITE
    height: dp(48)
    callback: root.context['callback']

<HomeViewPets@ViewAction>:
    text: 'Ver todas mis mascotas'
    bg: design.WHITE
    fg: design.TEAL
    height: dp(48)
    callback: root.context['callback']


<HomeQrCard@UxPress>:
    callback: root.context['callback']
    bg: design.MINT
    shadow: False
    radius: design.CARD_RADIUS
    padding: dp(18)
    spacing: dp(6)
    ViewRow:
        height: max(dp(54), root.ids.qr_copy.minimum_height)
        spacing: dp(design.GAP)
        ViewIconTile:
            icon: 'tag-outline'
            tile_size: 52
            bg: design.WHITE
            size_hint_x: None
            width: dp(52)
            pos_hint: {'center_y': .5}
        ViewColumn:
            id: qr_copy
            adaptive: True
            spacing: dp(4)
            ViewText:
                text: 'Chapa QR'
                font_size: sp(23)
                color: rgba(design.INK)
                bold: True
                wrap: True
                size_hint_y: None
                height: self.texture_size[1]
            ViewText:
                text: 'Consulta su ficha y elige cómo pueden contactarte.'
                font_size: sp(13)
                color: rgba(design.MUTED)
                wrap: True
                size_hint_y: None
                height: self.texture_size[1]
    ViewAction:
        text: 'Abrir chapa'
        icon: 'arrow-right'
        bg: design.INK
        fg: design.WHITE
        callback: root.context['callback']

<TagPreview>:
    adaptive: False
    padding: 0
    bg: design.INK
    ViewImage:
        source: root.source
        fit_mode: 'contain'

<TagLarge@TagTurner>:
    adaptive: False
    bg: design.INK
    padding: dp(12)
    ViewImage:
        id: image
        source: root.context['source']
        fit_mode: 'contain'
        canvas.before:
            PushMatrix:
            Scale:
                x: root.turn_scale
                y: 1
                origin: self.center
        canvas.after:
            PopMatrix:

<ChapaIntro@ViewCard>:
    bg: design.INK
    padding: dp(22)
    spacing: dp(12)
    ViewRow:
        height: min(dp(216), self.width / 2 + dp(32))
        spacing: dp(10)
        ViewColumn:
            spacing: dp(4)
            TagPreview:
                source: root.context['source']
                callback: root.context['front']
            ViewText:
                text: 'Frente'
                halign: 'center'
                color: rgba('#D7E8E2')
                font_size: sp(12)
                size_hint_y: None
                height: dp(20)
        ViewColumn:
            spacing: dp(4)
            TagPreview:
                source: root.context['back_source']
                callback: root.context['back']
            ViewText:
                text: 'Reverso'
                halign: 'center'
                color: rgba('#D7E8E2')
                font_size: sp(12)
                size_hint_y: None
                height: dp(20)
    ViewText:
        text: 'Chapa de ejemplo'
        halign: 'center'
        color: rgba('#D7E8E2')
        font_size: sp(12)
        size_hint_y: None
        height: dp(20)
    ViewText:
        text: 'Su información al escanear'
        font_size: sp(24)
        color: rgba(design.WHITE)
        bold: True
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
    ViewText:
        text: 'Quien la encuentre podrá escanear su chapa y contactar contigo según las opciones que autorices.'
        font_size: sp(design.BODY)
        color: rgba('#D7E8E2')
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)

<HomeAccount@ViewCard>:
    bg: design.BLUE
    padding: dp(16)
    spacing: dp(10)
    ViewText:
        text: 'Guarda tus mascotas en tu cuenta'
        font_size: sp(16)
        color: rgba(design.TEAL)
        bold: True
        size_hint_y: None
        height: dp(25)
    ViewText:
        text: 'Tus datos ya se guardan en este teléfono. Con una cuenta puedes recuperarlos en otro.'
        font_size: sp(12)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(51)
    ViewAction:
        text: 'Guardar en mi cuenta'
        icon: 'cloud-outline'
        callback: root.context['callback']

<PetsRegister@ViewAction>:
    text: 'Registrar mascota'
    icon: 'plus'
    bg: design.INK
    fg: design.WHITE
    callback: root.context['callback']

<PetsEmpty@ViewText>:
    text: 'Aquí verás sus perfiles y datos de cuidado.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(60)

<PetCard@ViewCard>:
    padding: dp(16)
    spacing: dp(10)
    accent: True
    ViewRow:
        height: dp(76)
        spacing: dp(design.GAP)
        ViewPetAvatar:
            kind: root.context['kind']
            size_hint_x: None
            width: dp(74)
        ViewColumn:
            spacing: dp(4)
            ViewText:
                text: root.context['name']
                font_size: sp(21)
                color: rgba(design.TEXT)
                bold: True
                size_hint_y: None
                height: dp(30)
                shorten: True
            ViewText:
                text: root.context['summary']
                font_size: sp(12)
                color: rgba('#71838B')
                size_hint_y: None
                height: dp(30)
                shorten: True
    ViewText:
        text: root.context['details']
        font_size: sp(12)
        color: rgba(design.TEAL)
        size_hint_y: None
        height: dp(30)
        shorten: True
    ViewAction:
        text: root.context['qr_label']
        icon: 'qrcode-scan'
        bg: design.BLUE
        fg: design.TEAL
        callback: root.context['open_qr']
    ViewAction:
        text: 'Ver perfil'
        icon: 'arrow-right'
        bg: design.TEAL
        fg: design.WHITE
        callback: root.context['open_profile']

<PetsQrCard@ViewCard>:
    padding: dp(16)
    spacing: dp(10)

<PetsOpenQr@ViewAction>:
    text: 'Abrir mi chapa QR'
    icon: 'qrcode-scan'
    callback: root.context['callback']

<ProfileAvatar@ViewRow>:
    height: dp(140)
    Widget:
    PetPortrait:
        breed: root.context.get('breed', '')
        kind: root.context['kind']
        size: dp(112), dp(140)
    Widget:

<ProfileSummary@ViewText>:
    text: root.context['text']
    font_size: sp(design.BODY)
    color: rgba(design.TEXT)
    wrap: True
    size_hint_y: None
    height: self.texture_size[1] + dp(12)

<ProfileHealth@ViewAction>:
    text: 'Ver expediente'
    icon: 'heart-pulse'
    callback: root.context['callback']

<ProfileQr@ViewAction>:
    text: 'Ver chapa QR'
    icon: 'qrcode-scan'
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']

<ProfileEdit@ViewAction>:
    text: 'Editar perfil'
    icon: 'pencil-outline'
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']

<ProfileDelete@ViewAction>:
    text: 'Eliminar mascota'
    bg: '#FFF0E9'
    fg: '#A44D2E'
    callback: root.context['callback']

<RoutineAdd@ViewAction>:
    text: 'Añadir cuidado'
    icon: 'plus'
    callback: root.context['callback']

<RoutineCount@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba(design.MUTED)
    wrap: True
    size_hint_y: None
    height: self.texture_size[1] + dp(4)

<RoutineEmpty@ViewText>:
    wrap: True
    text: 'Empieza con un paseo, un medicamento o una cita. Puedes activar sus avisos desde tu cuenta.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(55)

<CareTaskCard@ViewCard>:
    border: True
    bg: root.context.get('bg', design.WHITE)
    radius: design.CARD_RADIUS
    shadow: False
    padding: dp(14)
    spacing: dp(8)

<AgendaEntry@ViewRow>:
    height: max(root.ids.body.minimum_height, root.ids.stamp.minimum_height) + dp(28)
    spacing: dp(design.GAP)
    padding: [0, dp(14)]
    canvas.after:
        Color:
            rgba: rgba('#D9E3DC')
        Line:
            points: self.x + dp(72), self.y, self.x + dp(72), self.top
            width: .6
    ViewColumn:
        id: stamp
        pos_hint: {'top': 1}
        size_hint_x: None
        width: dp(66)
        adaptive: True
        spacing: dp(5)
        ViewText:
            text: root.context['time']
            font_size: sp(21)
            bold: True
            size_hint_y: None
            height: dp(28) if self.text else 0
        ViewText:
            text: root.context['day']
            wrap: True
            font_size: sp(12)
            size_hint_y: None
            height: self.texture_size[1] + dp(4)
        ViewText:
            text: '✓ Hecho' if root.context['done'] else ''
            color: rgba(design.TEAL)
            font_size: sp(12)
            wrap: True
            size_hint_y: None
            height: self.texture_size[1] + dp(4) if self.text else 0
    ViewColumn:
        id: body
        adaptive: True
        spacing: dp(8)

<CareTaskHeading@ViewRow>:
    height: max(dp(40), root.ids.task_title.texture_size[1] + dp(4))
    spacing: dp(12)
    ViewIconTile:
        icon: root.context['icon']
        tile_size: 40
        bg: design.WHITE
    ViewText:
        id: task_title
        text: root.context['text']
        wrap: True
        bold: True
        font_size: sp(18)

<CareTaskDate@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(design.BODY)
    color: rgba(design.TEAL)
    size_hint_y: None
    height: self.texture_size[1] + dp(4)

<CareTaskActions@ViewRow>:
    height: dp(48)
    spacing: dp(8)
    ViewAction:
        text: 'Ver detalles'
        bg: design.WHITE
        fg: design.TEAL
        callback: root.context['callback']

<CareTaskToggle@ViewAction>:
    text: root.context['text']
    icon: root.context['icon']
    bg: design.LIME
    fg: design.INK
    callback: root.context['callback']

<TaskTitle@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(20)
    color: rgba(design.TEXT)
    bold: True
    size_hint_y: None
    height: max(dp(32), self.texture_size[1] + dp(4))

<TaskSummary@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba(design.TEAL)
    size_hint_y: None
    wrap: True
    height: self.texture_size[1] + dp(12)

<TaskDetailDetails@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    wrap: True
    height: self.texture_size[1] + dp(12)

<TaskDetailScroll@ViewScrollView>:
    do_scroll_x: False

<TaskComplete@ViewAction>:
    text: root.context['text']
    icon: 'check'
    callback: root.context['callback']

<TaskEdit@ViewAction>:
    text: 'Editar cuidado'
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']

<TaskDelete@ViewAction>:
    text: 'Eliminar cuidado'
    bg: '#FFF0E9'
    fg: '#A44D2E'
    callback: root.context['callback']

<HealthEmptyPets@ViewText>:
    text: 'Registra tu mascota para crear su expediente.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(55)

<HealthRegisterPet@ViewAction>:
    text: 'Registrar mascota'
    icon: 'plus'
    callback: root.context['callback']

<HealthChange@ViewAction>:
    text: 'Cambiar mascota'
    icon: 'chevron-down'
    bg: design.MINT
    fg: design.INK
    font_size: 14
    callback: root.context['callback']

<HealthPetOption@HomePetRow>:
    bg: design.LIME if root.context['selected'] else design.WHITE

<HealthSummary@ViewCard>:
    bg: design.MINT
    shadow: False
    padding: dp(16)
    spacing: dp(8)
    ViewRow:
        height: max(dp(80), root.ids.health_name.minimum_height)
        spacing: dp(design.GAP)
        PetPortrait:
            kind: root.context['kind']
            breed: root.context.get('breed', '')
            size: dp(64), dp(80)
            pos_hint: {'center_y': .5}
        ViewColumn:
            id: health_name
            adaptive: True
            pos_hint: {'center_y': .5}
            ViewText:
                text: root.context['name']
                wrap: True
                size_hint_y: None
                height: self.texture_size[1] + dp(4)
                font_size: sp(24)
                bold: True
    ViewText:
        text: root.context['weight']
        wrap: True
        font_size: sp(design.BODY)
        size_hint_y: None
        height: self.texture_size[1] + dp(4) if self.text else 0
    ViewText:
        text: root.context['summary']
        wrap: True
        font_size: sp(design.BODY)
        color: rgba('#71838B')
        size_hint_y: None
        height: self.texture_size[1] + dp(8)

    ViewAction:
        icon: 'file-export-outline'
        text: 'Compartir PDF'
        callback: root.context.get('export')
        bg: design.WHITE
        fg: design.INK

<HealthAddEvent@ViewAction>:
    text: 'Añadir al historial'
    icon: 'clipboard-plus-outline'
    callback: root.context['callback']

<HealthHistory@ViewAction>:
    text: 'Ver historial'
    icon: 'history'
    bg: design.MINT
    fg: design.INK
    callback: root.context['callback']

<HealthTreatmentTitle@ViewText>:
    wrap: True
    text: 'Cuidados de salud pendientes'
    font_size: sp(18)
    color: rgba(design.TEXT)
    bold: True
    size_hint_y: None
    height: max(dp(30), self.texture_size[1] + dp(4))

<HealthEmptyTasks@ViewText>:
    text: 'No hay cuidados de salud pendientes.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(36)

<HealthAddTreatment@ViewAction>:
    text: 'Añadir tratamiento o cita'
    icon: 'plus'
    callback: root.context['callback']

<HistoryScroll@ViewScrollView>:
    do_scroll_x: False

<HistoryEntries@ViewColumn>:
    adaptive: True
    spacing: dp(12)

<HistoryEmpty@ViewText>:
    text: 'Todavía no hay eventos registrados.'
    font_size: sp(design.BODY)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(70)

<HistoryItem@ViewCard>:
    border: True
    bg: design.BLUE
    padding: dp(12)
    spacing: dp(6)
    ViewText:
        text: root.context['title']
        font_size: sp(17)
        color: rgba(design.TEXT)
        bold: True
        size_hint_y: None
        height: dp(32)
        shorten: True
    ViewText:
        text: root.context['date']
        font_size: sp(11)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(28)

<HistoryBody@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba(design.TEXT)
    size_hint_y: None
    wrap: True
    height: self.texture_size[1] + dp(10)

<HistoryEdit@ViewAction>:
    text: 'Editar evento'
    bg: design.WHITE
    fg: design.TEAL
    callback: root.context['callback']

<HistoryDelete@ViewAction>:
    text: 'Eliminar evento'
    bg: design.WHITE
    fg: '#71838B'
    callback: root.context['callback']

<FormScroll@ViewScrollView>:
    do_scroll_x: False

<FormInputs@ViewColumn>:
    adaptive: True
    spacing: dp(10)

<FormFieldRow@ViewColumn>:
    adaptive: True
    spacing: dp(4)
    ViewText:
        text: root.context['text']
        wrap: True
        font_size: sp(12)
        color: rgba(design.MUTED)
        size_hint_y: None
        height: max(dp(25), self.texture_size[1] + dp(4))

<FormChoice@ViewSpinner>:
    text: root.context['text']
    values: root.context['values']
    size_hint_y: None
    height: dp(48)

<PetFormPreview>:
    size_hint_y: None
    height: dp(96)
    spacing: dp(design.GAP)
    padding: [dp(4), dp(4)]
    Widget:
    PetPortrait:
        id: portrait
        size: dp(72), dp(88)
    Widget:

<FormTextInput@ViewTextInput>:
    text: root.context['text']
    multiline: root.context['multiline']
    password: root.context['password']
    size_hint_y: None
    height: dp(96 if root.context['multiline'] else 48)
    font_size: sp(design.BODY)
    padding: [dp(12), dp(10) if self.multiline else max(0, (self.height - self.line_height) / 2)]
    background_normal: ''
    background_active: ''
    background_color: 0, 0, 0, 0
    foreground_color: (0.06, 0.19, 0.22, 1)
    hint_text: root.context['hint_text']
    hint_text_color: rgba(design.MUTED)
    input_type: root.context['input_type']
    cursor_color: rgba(design.INK)
    canvas.before:
        Color:
            rgba: rgba(design.WHITE if self.focus else '#F1F5F1')
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: rgba(design.TEAL if self.focus else '#718D8A')
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
            width: 1.2 if self.focus else .6
        Color:
            rgba: self.disabled_foreground_color if self.disabled else (self.foreground_color if self.text else self.hint_text_color)

<FormShortcuts@ViewRow>:
    height: dp(36)
    spacing: dp(6)

<FormDateShortcut@ViewAction>:
    text: root.context['text']
    bg: design.BLUE
    fg: design.TEAL
    height: dp(36)
    font_size: 10
    callback: root.context['callback']

<FormTemplateRow@ViewColumn>:
    adaptive: True
    spacing: dp(4)
    ViewText:
        text: 'Ideas rápidas'
        font_size: sp(10)
        color: rgba(design.TEAL)
        size_hint_y: None
        height: dp(23)

<FormTemplate@ViewSpinner>:
    text: 'Elegir idea rápida'
    values: root.context['values']
    size_hint_y: None
    height: dp(48)

<FormError@ViewText>:
    text: ''
    font_size: sp(design.BODY)
    wrap: True
    color: rgba('#AA4625')
    size_hint_y: None
    height: max(dp(44), self.texture_size[1] + dp(8)) if self.text else 0

<FormSubmit@ViewAction>:
    text: root.context['text']
    icon: 'check'
    callback: root.context['callback']

<RegistrationPrompt@ViewText>:
    text: root.context['text']
    font_size: sp(design.BODY)
    color: rgba('#71838B')
    wrap: True
    size_hint_y: None
    height: self.texture_size[1] + dp(12)

<RegistrationStart@ViewAction>:
    text: 'Registrar mascota'
    icon: 'paw'
    callback: root.context['callback']

<RegistrationCancel@ViewAction>:
    text: 'Ahora no'
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']

<ConfirmationBody@ViewText>:
    text: root.context['text']
    font_size: sp(design.BODY)
    color: rgba('#71838B')
    wrap: True
    size_hint_y: None
    height: self.texture_size[1] + dp(12)

<ConfirmationAccept@ViewAction>:
    text: 'Confirmar'
    callback: root.context['callback']

<ConfirmationCancel@ViewAction>:
    text: 'Cancelar'
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']

<NotificationsScroll@ViewScrollView>:
    do_scroll_x: False

<NotificationsContent@ViewColumn>:
    adaptive: True
    spacing: dp(12)

<NotificationDate@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(30)

<NotificationOpenTask@ViewAction>:
    text: root.context['text']
    bg: design.BLUE
    fg: design.TEAL
    callback: root.context['callback']

<NotificationsEmpty@ViewText>:
    text: 'No hay recordatorios vencidos.'
    font_size: sp(design.BODY)
    color: rgba(design.TEXT)
    size_hint_y: None
    height: dp(60)

<QrInfoScroll@ViewScrollView>:
    do_scroll_x: False

<QrInfoBody@ViewColumn>:
    adaptive: True
    spacing: dp(13)
    size_hint_x: None
    width: self.parent.width if self.parent else dp(100)

<QrTitle@ViewText>:
    text: 'Vista previa del QR'
    font_size: sp(11)
    color: rgba(design.TEAL)
    bold: True
    size_hint_y: None
    height: dp(24)

<QrExpiredTitle@ViewText>:
    text: 'La prueba terminó'
    font_size: sp(22)
    color: rgba(design.TEXT)
    bold: True
    size_hint_y: None
    height: dp(36)

<QrExpiredDescription@ViewText>:
    text: 'La vista previa terminó. Crea una cuenta para activar su chapa.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(84)

<QrActiveTitle@ViewText>:
    text: 'Escanea para ver sus datos'
    font_size: sp(21)
    color: rgba(design.TEXT)
    bold: True
    size_hint_y: None
    height: dp(36)

<QrTrialPeriod@ViewText>:
    text: root.context['text']
    font_size: sp(10)
    color: rgba(design.TEAL)
    bold: True
    size_hint_y: None
    height: dp(25)

<QrInfoQrFrame@ViewCard>:
    bg: design.WHITE
    padding: dp(8)
    radius: 20
    ViewImage:
        source: root.context['source']
        size_hint_y: None
        height: dp(240)

<QrExpiry@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba(design.TEXT)
    size_hint_y: None
    height: dp(43)

<QrPrivacy@ViewText>:
    text: 'Este QR guarda una copia de sus datos. No cambia al editar el perfil. Quien guarde una imagen podrá conservar esa información.'
    font_size: sp(12)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(80)

<QrFilePath@ViewText>:
    text: root.context['text']
    font_size: sp(10)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(47)

<QrInfoPlate@ViewCard>:
    bg: design.BLUE
    padding: dp(14)
    spacing: dp(8)
    radius: 20
    ViewText:
        text: 'PRÓXIMAMENTE, PLACA FÍSICA'
        font_size: sp(11)
        color: rgba(design.TEAL)
        bold: True
        size_hint_y: None
        height: dp(25)

<PlateSideTitle@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba(design.TEXT)
    bold: True
    size_hint_y: None
    height: dp(24)

<PlateSideImage@ViewImage>:
    source: root.context['source']
    fit_mode: 'contain'
    size_hint_y: None
    height: dp(205)

<PlatePreview@ViewImage>:
    source: root.context['source']
    size_hint_y: None
    height: dp(180)

<PlateFallback@ViewText>:
    text: 'Vista de la chapa no disponible.'
    font_size: sp(design.BODY)
    color: rgba(design.TEXT)
    size_hint_y: None
    height: dp(56)

<PlateDisclaimer@ViewText>:
    text: 'Chapa de ejemplo. Ese QR no se puede usar. Venta y envío no disponibles.'
    font_size: sp(11)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(70)

<AccountScroll@ViewScrollView>:
    do_scroll_x: False

<AccountBody@ViewColumn>:
    adaptive: True
    spacing: dp(12)
    ViewText:
        text: root.context['text']
        font_size: sp(16)
        color: rgba(design.TEAL)
        size_hint_y: None
        height: dp(50)
    ViewText:
        text: 'Tu perfil y los datos de tus mascotas.'
        font_size: sp(13)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(42)

<AccountAction@ViewAction>:
    text: root.context['text']
    bg: design.BLUE
    fg: design.TEXT
    callback: root.context['callback']

<AccountPrimary@ViewAction>:
    text: root.context['text']
    bg: design.INK
    fg: design.WHITE
    callback: root.context['callback']

<AccountSection@ViewText>:
    text: root.context['text']
    bold: True
    font_size: sp(11)
    color: rgba(design.TEAL)
    size_hint_y: None
    height: dp(30)

<AccountNote@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(13)
    color: rgba('#52676F')
    size_hint_y: None
    height: self.texture_size[1] + dp(18)

<AccountProfile@ViewCard>:
    bg: design.BLUE
    ViewIconTile:
        icon: 'account-heart-outline'
    ViewText:
        text: root.context['name']
        font_size: sp(22)
        bold: True
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(8)
    ViewText:
        text: root.context['detail']
        font_size: sp(design.BODY)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(8)

<PasswordRow@ViewRow>:
    height: dp(48)
    spacing: dp(4)

<PasswordEye@ViewAction>:
    icon: 'eye-outline'
    bg: design.BLUE
    fg: design.TEAL
    size_hint_x: None
    width: dp(48)
    callback: root.context['callback']

<AccountSessionNote@ViewText>:
    text: 'Al cerrar sesión verás las mascotas guardadas sin cuenta.'
    font_size: sp(12)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(55)

<NetworkWait@ViewModalView>:
    size_hint: (None, None)
    size: dp(68), dp(68)
    auto_dismiss: False
    background_color: (0, 0, 0, 0)
    ViewCard:
        adaptive: False
        padding: dp(16)
        MDSpinner:
            size_hint: None, None
            size: dp(36), dp(36)
            color: rgba(design.TEAL)
            active: root.opacity > 0


<HomeCareTip@ViewCard>:
    adaptive: True
    bg: '#F4F6F6'
    shadow: False
    padding: dp(16)
    spacing: dp(6)
    ViewText:
        text: 'Consejo de cuidado'
        bold: True
        font_size: sp(16)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
    ViewText:
        id: tip_text
        text: root.context['message']
        markup: False
        wrap: True
        font_size: sp(design.BODY)
        size_hint_y: None
        height: self.texture_size[1] + dp(6)
