#:import rgba kivy.utils.get_color_from_hex

<HomeFloatingTag@ViewFloatingTag>:
    size_hint_x: None
    width: dp(112)

<HomeVectorTag@ViewTagArt>:
    size_hint_x: None
    width: dp(112)

<RoutineImageBanner@ViewSpaBanner>:
    size_hint_y: None
    height: dp(150)

<RoutineVectorBanner@ViewSpaArt>:
    size_hint_y: None
    height: dp(150)

<HomeHero@ViewCard>:
    bg: '#103D49'
    padding: dp(20)
    spacing: dp(10)
    radius: 28
    ViewRow:
        height: dp(22)
        spacing: dp(4)
        ViewText:
            text: 'SU CHAPA QR'
            font_size: sp(10)
            color: rgba('#DAEFA0')
            bold: True
        ViewText:
            text: '14 DÍAS'
            font_size: sp(10)
            color: rgba('#DAEFA0')
            bold: True
            halign: 'right'
            size_hint_x: 0.35

<HomeHeroStory@ViewRow>:
    height: dp(142)
    spacing: dp(0)
    ViewText:
        text: 'Si se pierde,\nque vuelva\ncontigo.'
        font_size: sp(22)
        color: rgba('#FFFFFF')
        bold: True

<HomeQrDescription@ViewText>:
    text: 'Si alguien la encuentra, podrá escanear su chapa y escribirte. Actívala con tu cuenta.'
    font_size: sp(12)
    color: rgba('#D8EAEC')
    size_hint_y: None
    height: dp(46)

<HomeOpenQr@ViewAction>:
    text: 'Ver su chapa QR'
    icon: 'qrcode-scan'
    bg: '#DAEFA0'
    fg: '#103D49'
    height: dp(50)
    radius: 16
    callback: root.context['callback']

<HomeOverview@ViewColumn>:
    adaptive: True
    spacing: dp(10)
    ViewText:
        text: 'HOY EN UN VISTAZO'
        font_size: sp(11)
        color: rgba('#286F83')
        bold: True
        size_hint_y: None
        height: dp(24)

<HomeCounts@ViewRow>:
    height: dp(86)
    spacing: dp(6)

<HomeMetric@ViewColumn>:
    spacing: dp(0)
    ViewText:
        text: root.context['number']
        font_size: sp(29)
        color: rgba('#193C47')
        bold: True
        size_hint_y: None
        height: dp(43)
    ViewText:
        text: root.context['label']
        font_size: sp(11)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(38)

<HomeEmptyPets@ViewText>:
    text: 'Empieza por registrar a tu mascota.\nNo necesitas crear una cuenta.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(44)

<HomeRegisterPet@ViewAction>:
    text: 'Registrar mi primera mascota'
    icon: 'paw'
    callback: root.context['callback']

<HomeViewPets@ViewAction>:
    text: 'Ver mis mascotas'
    icon: 'paw'
    callback: root.context['callback']

<HomeNextCare@ViewCard>:
    padding: dp(16)
    spacing: dp(10)
    ViewText:
        text: 'PRÓXIMO CUIDADO'
        font_size: sp(11)
        color: rgba('#286F83')
        size_hint_y: None
        height: dp(20)

<HomeCareDetails@ViewAction>:
    text: 'Ver detalle y completar'
    icon: 'check-circle-outline'
    callback: root.context['callback']

<HomeAccount@ViewCard>:
    bg: '#E7F3F4'
    padding: dp(16)
    spacing: dp(10)
    ViewText:
        text: 'Guarda tus mascotas en tu cuenta'
        font_size: sp(16)
        color: rgba('#286F83')
        bold: True
        size_hint_y: None
        height: dp(25)
    ViewText:
        text: 'Tus datos ya se guardan en este teléfono. Con una cuenta puedes recuperarlos en otro.'
        font_size: sp(12)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(51)
    ViewAction:
        text: 'Guardar en mi cuenta'
        icon: 'cloud-outline'
        callback: root.context['callback']

<PetsRegister@ViewAction>:
    text: 'Registrar mascota'
    icon: 'plus'
    callback: root.context['callback']

<PetsEmpty@ViewText>:
    text: 'Aquí verás sus perfiles y datos de cuidado.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(60)

<PetCard@ViewCard>:
    padding: dp(16)
    spacing: dp(10)
    accent: True
    ViewRow:
        height: dp(76)
        spacing: dp(14)
        ViewPetAvatar:
            kind: root.context['kind']
            size_hint_x: None
            width: dp(74)
        ViewColumn:
            spacing: dp(4)
            ViewText:
                text: root.context['name']
                font_size: sp(21)
                color: rgba('#193C47')
                bold: True
                size_hint_y: None
                height: dp(30)
                shorten: True
            ViewText:
                text: root.context['summary']
                font_size: sp(12)
                color: rgba('#71838B')
                size_hint_y: None
                height: dp(30)
                shorten: True
    ViewText:
        text: root.context['details']
        font_size: sp(12)
        color: rgba('#286F83')
        size_hint_y: None
        height: dp(30)
        shorten: True
    ViewAction:
        text: root.context['qr_label']
        icon: 'qrcode-scan'
        bg: '#E7F3F4'
        fg: '#286F83'
        callback: root.context['open_qr']
    ViewAction:
        text: 'Ver perfil y editar'
        icon: 'arrow-right'
        bg: '#E7F3F4'
        fg: '#286F83'
        callback: root.context['open_profile']

<PetsQrCard@ViewCard>:
    padding: dp(16)
    spacing: dp(10)

<PetsOpenQr@ViewAction>:
    text: 'Abrir mi chapa QR'
    icon: 'qrcode-scan'
    callback: root.context['callback']

<ProfileAvatar@ViewPetAvatar>:
    kind: root.context['kind']
    size_hint_y: None
    height: dp(95)

<ProfileSummary@ViewText>:
    text: root.context['text']
    font_size: sp(14)
    color: rgba('#193C47')

<ProfileHealth@ViewAction>:
    text: 'Ver expediente'
    icon: 'heart-pulse'
    callback: root.context['callback']

<ProfileQr@ViewAction>:
    text: 'Ver chapa QR'
    icon: 'qrcode-scan'
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<ProfileEdit@ViewAction>:
    text: 'Editar perfil'
    icon: 'pencil-outline'
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<ProfileDelete@ViewAction>:
    text: 'Eliminar mascota'
    bg: '#FFF0E9'
    fg: '#A44D2E'
    callback: root.context['callback']

<RoutineAdd@ViewAction>:
    text: 'Añadir cuidado'
    icon: 'plus'
    callback: root.context['callback']

<RoutineCount@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(24)

<RoutineEmpty@ViewText>:
    wrap: True
    text: 'Empieza con un paseo, un medicamento o una cita. Puedes activar sus avisos desde tu cuenta.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(55)

<CareTaskCard@ViewCard>:
    padding: dp(14)
    spacing: dp(8)

<CareTaskDate@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba('#286F83')
    size_hint_y: None
    height: dp(24)

<CareTaskActions@ViewRow>:
    height: dp(44)
    spacing: dp(8)
    ViewAction:
        text: 'Ver detalles'
        bg: '#E7F3F4'
        fg: '#286F83'
        callback: root.context['callback']

<CareTaskToggle@ViewAction>:
    text: root.context['text']
    icon: 'check'
    callback: root.context['callback']

<TaskTitle@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(20)
    color: rgba('#193C47')
    bold: True
    size_hint_y: None
    height: max(dp(32), self.texture_size[1] + dp(4))

<TaskSummary@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba('#286F83')
    size_hint_y: None
    height: dp(65)

<TaskDetailDetails@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    wrap: True
    height: self.texture_size[1] + dp(12)

<TaskDetailScroll@ViewScrollView>:
    do_scroll_x: False

<TaskComplete@ViewAction>:
    text: root.context['text']
    icon: 'check'
    callback: root.context['callback']

<TaskEdit@ViewAction>:
    text: 'Editar cuidado'
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<TaskDelete@ViewAction>:
    text: 'Eliminar cuidado'
    bg: '#FFF0E9'
    fg: '#A44D2E'
    callback: root.context['callback']

<HealthEmptyPets@ViewText>:
    text: 'Registra tu mascota para crear su expediente.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(55)

<HealthRegisterPet@ViewAction>:
    text: 'Registrar mascota'
    icon: 'plus'
    callback: root.context['callback']

<HealthSelector@ViewSpinner>:
    text: root.context['text']
    values: root.context['values']
    size_hint_y: None
    height: dp(44)

<HealthSummary@ViewCard>:
    padding: dp(16)
    spacing: dp(8)
    accent: True
    ViewRow:
        height: max(dp(48), root.ids.pet_title.texture_size[1] + dp(4))
        ViewText:
            id: pet_title
            text: root.context['name']
            wrap: True
            font_size: sp(21)
            color: rgba('#193C47')
            bold: True
        ViewAction:
            icon: 'file-export-outline'
            text: 'PDF'
            font_size: sp(12)
            callback: root.context.get('export')
            bg: '#FFFFFF'
            fg: '#286F83'
            size_hint_x: None
            width: dp(70)
    ViewText:
        text: root.context['summary']
        wrap: True
        font_size: sp(12)
        color: rgba('#71838B')
        size_hint_y: None
        height: self.texture_size[1] + dp(8)

<HealthAddEvent@ViewAction>:
    text: 'Añadir al historial'
    icon: 'clipboard-plus-outline'
    callback: root.context['callback']

<HealthHistory@ViewAction>:
    text: 'Consultar historial'
    icon: 'history'
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<HealthTreatmentTitle@ViewText>:
    wrap: True
    text: 'Tratamientos y próximas citas'
    font_size: sp(18)
    color: rgba('#193C47')
    bold: True
    size_hint_y: None
    height: max(dp(30), self.texture_size[1] + dp(4))

<HealthEmptyTasks@ViewText>:
    text: 'No hay tratamientos o citas pendientes.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(36)

<HealthAddTreatment@ViewAction>:
    text: 'Añadir tratamiento o cita'
    icon: 'plus'
    callback: root.context['callback']

<HistoryScroll@ViewScrollView>:
    do_scroll_x: False

<HistoryEntries@ViewColumn>:
    adaptive: True
    spacing: dp(12)

<HistoryEmpty@ViewText>:
    text: 'Todavía no hay eventos registrados.'
    font_size: sp(14)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(70)

<HistoryItem@ViewCard>:
    bg: '#E7F3F4'
    padding: dp(12)
    spacing: dp(6)
    ViewText:
        text: root.context['title']
        font_size: sp(17)
        color: rgba('#193C47')
        bold: True
        size_hint_y: None
        height: dp(32)
        shorten: True
    ViewText:
        text: root.context['date']
        font_size: sp(11)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(28)

<HistoryBody@ViewText>:
    text: root.context['text']
    font_size: sp(13)
    color: rgba('#193C47')
    size_hint_y: None
    wrap: True
    height: self.texture_size[1] + dp(10)

<HistoryEdit@ViewAction>:
    text: 'Editar evento'
    bg: '#FFFFFF'
    fg: '#286F83'
    callback: root.context['callback']

<HistoryDelete@ViewAction>:
    text: 'Eliminar evento'
    bg: '#FFFFFF'
    fg: '#71838B'
    callback: root.context['callback']

<FormScroll@ViewScrollView>:
    do_scroll_x: False

<FormInputs@ViewColumn>:
    adaptive: True
    spacing: dp(10)

<FormFieldRow@ViewColumn>:
    adaptive: True
    spacing: dp(4)
    ViewText:
        text: root.context['text']
        wrap: True
        font_size: sp(12)
        color: rgba('#71838B')
        size_hint_y: None
        height: max(dp(25), self.texture_size[1] + dp(4))

<FormChoice@ViewSpinner>:
    text: root.context['text']
    values: root.context['values']
    size_hint_y: None
    height: dp(44)

<FormTextInput@ViewTextInput>:
    text: root.context['text']
    multiline: root.context['multiline']
    password: root.context['password']
    size_hint_y: None
    height: dp(85 if root.context['multiline'] else 44)
    font_size: sp(14)
    padding: [dp(12), dp(10)]
    background_normal: ''
    background_active: ''
    background_color: (0.94, 0.97, 0.98, 1)
    foreground_color: (0.06, 0.19, 0.22, 1)
    hint_text: root.context['hint_text']
    input_type: root.context['input_type']

<FormShortcuts@ViewRow>:
    height: dp(36)
    spacing: dp(6)

<FormDateShortcut@ViewAction>:
    text: root.context['text']
    bg: '#E7F3F4'
    fg: '#286F83'
    height: dp(36)
    font_size: 10
    callback: root.context['callback']

<FormTemplateRow@ViewColumn>:
    adaptive: True
    spacing: dp(4)
    ViewText:
        text: 'EMPEZAR CON UNA IDEA · PUEDES CAMBIAR TODO'
        font_size: sp(10)
        color: rgba('#286F83')
        size_hint_y: None
        height: dp(23)

<FormTemplate@ViewSpinner>:
    text: 'Elegir idea rápida'
    values: root.context['values']
    size_hint_y: None
    height: dp(44)

<FormError@ViewText>:
    text: ''
    font_size: sp(12)
    color: rgba('#AA4625')
    size_hint_y: None
    height: dp(0)

<FormSubmit@ViewAction>:
    text: root.context['text']
    icon: 'check'
    callback: root.context['callback']

<RegistrationPrompt@ViewText>:
    text: root.context['text']
    font_size: sp(14)
    color: rgba('#71838B')

<RegistrationStart@ViewAction>:
    text: 'Registrar mascota'
    icon: 'paw'
    callback: root.context['callback']

<RegistrationCancel@ViewAction>:
    text: 'Ahora no'
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<ConfirmationBody@ViewText>:
    text: root.context['text']
    font_size: sp(14)
    color: rgba('#71838B')

<ConfirmationAccept@ViewAction>:
    text: 'Confirmar'
    callback: root.context['callback']

<ConfirmationCancel@ViewAction>:
    text: 'Cancelar'
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<NotificationsScroll@ViewScrollView>:
    do_scroll_x: False

<NotificationsContent@ViewColumn>:
    adaptive: True
    spacing: dp(12)
    ViewText:
        text: 'Avisos locales mientras la app está abierta.\nLas notificaciones push aún no están activadas.'
        font_size: sp(12)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(50)

<NotificationDate@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(30)

<NotificationOpenTask@ViewAction>:
    text: root.context['text']
    bg: '#E7F3F4'
    fg: '#286F83'
    callback: root.context['callback']

<NotificationsEmpty@ViewText>:
    text: 'No hay recordatorios vencidos.'
    font_size: sp(14)
    color: rgba('#193C47')
    size_hint_y: None
    height: dp(60)

<QrInfoScroll@ViewScrollView>:
    do_scroll_x: False

<QrInfoBody@ViewColumn>:
    adaptive: True
    spacing: dp(13)
    size_hint_x: None
    width: self.parent.width if self.parent else dp(100)

<QrTitle@ViewText>:
    text: '02 / TU CHAPA DIGITAL'
    font_size: sp(11)
    color: rgba('#286F83')
    bold: True
    size_hint_y: None
    height: dp(24)

<QrExpiredTitle@ViewText>:
    text: 'La prueba terminó'
    font_size: sp(22)
    color: rgba('#193C47')
    bold: True
    size_hint_y: None
    height: dp(36)

<QrExpiredDescription@ViewText>:
    text: 'Esta prueba de texto terminó. Con tu cuenta puedes crear una chapa con ficha web.'
    font_size: sp(13)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(84)

<QrActiveTitle@ViewText>:
    text: 'Pruébala con otra cámara'
    font_size: sp(21)
    color: rgba('#193C47')
    bold: True
    size_hint_y: None
    height: dp(36)

<QrTrialPeriod@ViewText>:
    text: root.context['text']
    font_size: sp(10)
    color: rgba('#286F83')
    bold: True
    size_hint_y: None
    height: dp(25)

<QrInfoQrFrame@ViewCard>:
    bg: '#FFFFFF'
    padding: dp(8)
    radius: 20
    ViewImage:
        source: root.context['source']
        size_hint_y: None
        height: dp(240)

<QrExpiry@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba('#193C47')
    size_hint_y: None
    height: dp(43)

<QrPrivacy@ViewText>:
    text: 'El QR muestra nombre y especie, y contacto solo si lo autorizaste. No publica una web. Una foto conserva el texto y los datos aunque cambies el contacto o termine la prueba.'
    font_size: sp(12)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(80)

<QrFilePath@ViewText>:
    text: root.context['text']
    font_size: sp(10)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(47)

<QrInfoPlate@ViewCard>:
    bg: '#E7F3F4'
    padding: dp(14)
    spacing: dp(8)
    radius: 20
    ViewText:
        text: 'PRÓXIMAMENTE · PLACA FÍSICA'
        font_size: sp(11)
        color: rgba('#286F83')
        bold: True
        size_hint_y: None
        height: dp(25)

<PlateSideTitle@ViewText>:
    text: root.context['text']
    font_size: sp(12)
    color: rgba('#193C47')
    bold: True
    size_hint_y: None
    height: dp(24)

<PlateSideImage@ViewImage>:
    source: root.context['source']
    fit_mode: 'contain'
    size_hint_y: None
    height: dp(205)

<PlatePreview@ViewImage>:
    source: root.context['source']
    size_hint_y: None
    height: dp(180)

<PlateFallback@ViewText>:
    text: 'Una placa con su nombre y un QR permanente para volver a casa.'
    font_size: sp(14)
    color: rgba('#193C47')
    size_hint_y: None
    height: dp(56)

<PlateDisclaimer@ViewText>:
    text: 'Vista referencial: el QR del mockup no funciona. Cada placa real necesitará un código propio. Compra y envío aún no disponibles.'
    font_size: sp(11)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(70)

<AccountScroll@ViewScrollView>:
    do_scroll_x: False

<AccountBody@ViewColumn>:
    adaptive: True
    spacing: dp(12)
    ViewText:
        text: root.context['text']
        font_size: sp(16)
        color: rgba('#286F83')
        size_hint_y: None
        height: dp(50)
    ViewText:
        text: 'Tu perfil y los datos de tus mascotas.'
        font_size: sp(13)
        color: rgba('#71838B')
        size_hint_y: None
        height: dp(42)

<AccountAction@ViewAction>:
    text: root.context['text']
    bg: '#E7F3F4'
    fg: '#193C47'
    callback: root.context['callback']

<AccountPrimary@ViewAction>:
    text: root.context['text']
    bg: '#286F83'
    fg: '#FFFFFF'
    callback: root.context['callback']

<AccountSection@ViewText>:
    text: root.context['text']
    bold: True
    font_size: sp(11)
    color: rgba('#286F83')
    size_hint_y: None
    height: dp(30)

<AccountNote@ViewText>:
    text: root.context['text']
    wrap: True
    font_size: sp(13)
    color: rgba('#52676F')
    size_hint_y: None
    height: self.texture_size[1] + dp(18)

<AccountProfile@ViewCard>:
    bg: '#E7F3F4'
    ViewIconTile:
        icon: 'account-heart-outline'
    ViewText:
        text: root.context['name']
        font_size: sp(22)
        bold: True
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(8)
    ViewText:
        text: root.context['detail']
        font_size: sp(14)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(8)

<PasswordRow@ViewRow>:
    height: dp(44)
    spacing: dp(4)

<PasswordEye@ViewAction>:
    icon: 'eye-outline'
    bg: '#E7F3F4'
    fg: '#286F83'
    size_hint_x: None
    width: dp(44)
    callback: root.context['callback']

<AccountSessionNote@ViewText>:
    text: 'Al cerrar sesión vuelves al espacio del invitado.'
    font_size: sp(12)
    color: rgba('#71838B')
    size_hint_y: None
    height: dp(55)

<NetworkWait@ViewModalView>:
    size_hint: (None, None)
    size: dp(68), dp(68)
    auto_dismiss: False
    background_color: (0, 0, 0, 0)
    ViewCard:
        adaptive: False
        padding: dp(16)
        MDSpinner:
            size_hint: None, None
            size: dp(36), dp(36)
            color: rgba('#286F83')
            active: root.opacity > 0


<HomeCareTip@ViewCard>:
    bg: '#E7F3F4'
    radius: 16
    padding: dp(16)
    spacing: dp(6)
    ViewText:
        text: 'Un consejo para su cuidado'
        bold: True
        font_size: sp(16)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
    ViewText:
        id: tip_text
        text: root.context['message']
        markup: False
        wrap: True
        font_size: sp(14)
        size_hint_y: None
        height: self.texture_size[1] + dp(6)
    ViewText:
        id: tip_status
        text: root.context['status']
        color: rgba('#42616A')
        font_size: sp(12)
        wrap: True
        size_hint_y: None
        height: self.texture_size[1] + dp(4)
