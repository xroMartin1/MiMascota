#:import design screens.theme
#:import rgba kivy.utils.get_color_from_hex
#:import md_icons kivymd.icon_definitions.md_icons
#:import fonts_path kivymd.fonts_path

<ViewColumn>:
    orientation: 'vertical'
    spacing: dp(8)

<ViewRow>:
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(40)
    spacing: dp(8)

<ViewText>:
    font_size: sp(design.BODY)
    color: rgba(design.TEXT)
    halign: 'left'
    valign: 'middle'
    text_size: (self.width, None) if self.wrap else self.size
    shorten_from: 'right'

<ViewCard>:
    padding: dp(design.CARD_PADDING)
    spacing: dp(10)
    canvas.before:
        PushMatrix:
        Scale:
            x: self.visual_scale
            y: self.visual_scale
            origin: self.center
        Color:
            rgba: (.05, .16, .14, .04) if self.shadow else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x, self.y - dp(3)
            size: self.size
            radius: [dp(self.radius)]
        Color:
            rgba: rgba(self.bg)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(self.radius)]
        Color:
            rgba: rgba(design.BORDER) if self.border else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x + dp(.5), self.y + dp(.5), max(0, self.width - dp(1)), max(0, self.height - dp(1)), dp(self.radius))
            width: dp(.7)
        Color:
            rgba: rgba(design.TEAL) if self.accent else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x + dp(13), self.top - dp(3)
            size: max(0, self.width - dp(26)), dp(3)
            radius: [dp(2)]
    canvas.after:
        Color:
            rgba: .03, .12, .14, self.press_amount * .1
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(self.radius)]
        PopMatrix:

<ViewAction>:
    shadow: False
    bg: design.INK
    radius: 16
    adaptive: False
    orientation: 'vertical' if self.vertical else 'horizontal'
    size_hint_y: 1 if self.vertical else None
    height: dp(48)
    padding: [dp(4 if self.vertical else 9), dp(5)]
    spacing: dp(4) if self.icon and self.text else 0
    ViewText:
        text: md_icons.get(root.icon, '')
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(22 if root.vertical or not root.text else 18)
        color: rgba(root.fg)
        halign: 'center'
        size_hint_x: 1 if root.icon and (root.vertical or not root.text) else None
        size_hint_y: 1 if root.vertical and root.icon else None
        pos_hint: {} if root.vertical else {'center_y': .5}
        width: dp(22) if root.icon else 0
        height: dp(22) if root.icon else 0
        opacity: 1 if root.icon else 0
    ViewText:
        text: root.text
        font_size: sp(root.font_size)
        color: rgba(root.fg)
        halign: 'center'
        bold: not root.vertical
        shorten: True
        size_hint_x: 1 if root.text else None
        size_hint_y: 1 if root.vertical and root.text else None
        pos_hint: {} if root.vertical else {'center_y': .5}
        width: 0
        height: self.texture_size[1] if root.text else 0

<ViewSpinnerOption>:
    background_normal: ''
    background_down: ''
    background_color: rgba(design.WHITE)
    color: rgba(design.TEXT)
    font_size: sp(design.BODY)
    height: dp(50)

<ViewSpinner>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: rgba(self.fg)
    font_size: sp(design.BODY)
    option_cls: 'ViewSpinnerOption'
    padding: 0, 0
    text_size: max(0, self.width - dp(48)), self.height
    halign: 'center'
    valign: 'middle'
    shorten: True
    canvas.before:
        Color:
            rgba: rgba(self.bg)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(14)]
        Color:
            rgba: rgba(design.TEAL) if self.is_open else (0, 0, 0, 0)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, dp(14))
            width: 1.2
    canvas.after:
        PushMatrix:
        Rotate:
            angle: self.arrow_angle
            origin: self.right - dp(18), self.center_y
        Color:
            rgba: rgba(self.fg)
        Line:
            points: self.right - dp(23), self.center_y + dp(3), self.right - dp(18), self.center_y - dp(2), self.right - dp(13), self.center_y + dp(3)
            width: dp(1.2)
        PopMatrix:

<ViewPill>:
    bg: '#FBEAE1' if self.warm else design.BLUE
    radius: 14
    orientation: 'horizontal'
    padding: [dp(10), dp(4)]
    spacing: dp(5) if self.icon else 0
    adaptive: False
    size_hint_y: None
    height: dp(27)
    ViewText:
        text: md_icons.get(root.icon, '')
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(13)
        halign: 'center'
        color: rgba('#A44D2E' if root.warm else design.TEAL)
        size_hint_x: None
        width: dp(14) if root.icon else 0
    ViewText:
        text: root.text
        font_size: sp(10)
        color: rgba('#A44D2E' if root.warm else design.TEAL)
        shorten: True

<ViewIconTile>:
    bg: design.BLUE
    radius: 13
    adaptive: False
    padding: 0
    size_hint: None, None
    size: dp(self.tile_size), dp(self.tile_size)
    pos_hint: {'center_y': .5}
    ViewText:
        text: md_icons.get(root.icon, '')
        font_name: fonts_path + 'materialdesignicons-webfont.ttf'
        font_size: sp(23)
        color: rgba('#A44D2E' if root.bg == '#FBEAE1' else design.TEAL)
        halign: 'center'

<PetPortrait>:
    size_hint: None, None
    size: dp(80), dp(96)
    padding: [dp(5), dp(8), dp(5), dp(4)]
    canvas.before:
        Color:
            rgba: rgba(design.WHITE)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.width / 2, self.width / 2, dp(12), dp(12)]
    ViewPetAvatar:
        breed: root.breed
        kind: root.kind

<FloatingTag>:
    Image:
        id: image
        source: root.source
        fit_mode: 'contain'
        size_hint: None, None
        size: dp(112), dp(142)

<SpaArt>:
    ViewText:
        id: tag
        text: 'DÍA DE SPA & BELLEZA'
        font_size: sp(10)
        color: rgba(design.TEAL)
        bold: True
    ViewText:
        id: title
        text: 'Momento de consentimiento'
        font_size: sp(18)
        color: rgba(design.WHITE)
        bold: True
    ViewText:
        id: caption
        text: 'Un pequeño mimo, una gran felicidad'
        font_size: sp(11)
        color: rgba('#C5ECE0')

<SpaBanner>:
    Image:
        source: root.source
        fit_mode: 'cover'
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
    ViewCard:
        bg: design.INK
        radius: 0
        padding: 0
        adaptive: False
        size_hint: 1, None
        height: dp(44)
        pos_hint: {'x': 0, 'y': 0}
    ViewCard:
        bg: design.WHITE
        radius: 15
        padding: [dp(10), 0]
        adaptive: False
        size_hint: None, None
        size: dp(153), dp(28)
        pos_hint: {'x': .045, 'top': .94}
        ViewText:
            text: 'DÍA DE SPA & MIMOS'
            font_size: sp(10)
            color: rgba(design.TEAL)
            bold: True
    ViewText:
        text: 'Su momento de mimos'
        font_size: sp(19)
        color: rgba(design.WHITE)
        bold: True
        size_hint: .9, None
        height: dp(31)
        x: self.parent.x + dp(16)
        y: self.parent.y + dp(7)
